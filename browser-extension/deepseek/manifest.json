{
  "manifest_version": 3,
  "name": "灵犀 DeepSeek 授权桥",
  "version": "0.1.3",
  "description": "用户发起授权时，将官方 DeepSeek 登录授权传回当前本机灵犀实例。",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://platform.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "pair.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://platform.deepseek.com/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://platform.deepseek.com/*"
      ],
      "js": [
        "official.js"
      ],
      "run_at": "document_start"
    }
  ]
}
